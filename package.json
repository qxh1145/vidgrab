{
  "name": "vidgrab",
  "version": "0.1.0",
  "private": true,
  "description": "Download videos from web pages",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "m3u8-parser": "^7.2.1",
    "mp4box": "^2.6.0",
    "mpd-parser": "^1.4.1",
    "mux.js": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^3.2.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}